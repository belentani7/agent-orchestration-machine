# Copy to /etc/belentani-factory/portfolio.env (root-owned, chmod 0600).
# Use a fine-grained READ-ONLY token scoped to intended private repositories.
# Never commit the real token, write it to logs or paste it into the browser.
PORTFOLIO_AUDIT_TOKEN=
# Optional: override batch start for deterministic reinspection.
# AUDIT_SCAN_OFFSET=0
